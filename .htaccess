Options -Indexes
ServerSignature Off

RewriteEngine On

# ── Pass Authorization header through to PHP ───────────────
# Apache on shared hosting strips the Authorization header before PHP sees it.
# Without these rules $_SERVER['HTTP_AUTHORIZATION'] is always empty, so every
# authenticated API request returns 401 "Session expired" immediately.
# Rule 1: native Apache CGI / mod_php — just expose the header as-is.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# Rule 2: FastCGI/PHP-FPM pools (common on cPanel/Plesk) — the header arrives
# as REDIRECT_HTTP_AUTHORIZATION after rewrite; copy it back to the expected var.
RewriteCond %{ENV:REDIRECT_HTTP_AUTHORIZATION} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{ENV:REDIRECT_HTTP_AUTHORIZATION}]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # ht7: HSTS — tells browsers to always use HTTPS for this domain.
    # Only sent over an HTTPS connection so it never appears on a plain-HTTP error page.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    # ht6: baseline CSP. 'unsafe-inline' for style/script is required because the
    # built frontend keeps a small inline bootstrap script and CSS-in-JS; tighten
    # further (nonces/hashes) once you've confirmed nothing else needs it.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'"
</IfModule>

# Route /api/* to api/index.php
RewriteCond %{REQUEST_URI} ^/api
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# SPA — all non-file/dir requests → index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api
RewriteRule ^ index.html [L]

# Block sensitive files (fl2: no .sql in webroot, fl7: no backups/archives accessible)
<FilesMatch "\.(sql|log|env|sh|bat|md|lock|json|php\.bak|bak|old|orig|swp|zip|gz|tar|7z|rar|ini|conf|config|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

# PHP settings (shared hosting)
<IfModule mod_php8.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_flag  display_errors Off
    php_flag  log_errors On
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
